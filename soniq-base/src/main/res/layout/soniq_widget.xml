<?xml version="1.0" encoding="utf-8"?>
<!--
  Home-screen widget. Deliberately styled from framework colours and the
  app's own label; a host app that wants its own look replaces this layout
  and SoniqWidgetProvider (see docs/WIDGETS.md).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/soniq_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/soniq_widget_art"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerCrop"
        android:contentDescription="@string/soniq_widget_art_description"
        android:src="@drawable/soniq_ic_music_note" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/soniq_widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/soniq_text_primary"
            android:text="@string/soniq_widget_idle_title" />

        <TextView
            android:id="@+id/soniq_widget_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="11sp"
            android:textColor="@color/soniq_text_secondary"
            android:text="@string/soniq_widget_idle_subtitle" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/soniq_widget_toggle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@android:color/transparent"
        android:padding="10dp"
        android:src="@drawable/soniq_ic_play"
        android:contentDescription="@string/soniq_action_play" />

    <ImageButton
        android:id="@+id/soniq_widget_next"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@android:color/transparent"
        android:padding="10dp"
        android:src="@drawable/soniq_ic_next"
        android:contentDescription="@string/soniq_action_next" />
</LinearLayout>
